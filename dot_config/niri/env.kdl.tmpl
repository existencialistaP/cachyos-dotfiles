environment {
    ELECTRON_OZONE_PLATFORM_HINT "auto"
    XDG_SESSION_TYPE "wayland"
    // XDG_CURRENT_DESKTOP "gnome"
    MOZ_ENABLE_WAYLAND "1"

    // --- Qt -------------------------------------------------------------------
    // Sem isso o ~/.config/qt6ct/qt6ct.conf (style=kvantum, fontes) é ignorado por
    // todo app lançado pelo niri/waybar. Antes só valia dentro de um fish.
    QT_QPA_PLATFORMTHEME "qt6ct"
    QT_WAYLAND_DISABLE_WINDOWDECORATION "1"
    // só vale para xcb (X11); sem XWayland instalado não faz nada, fica por histórico
    // QT_AUTO_SCREEN_SCALE_FACTOR "1"

    // GDK_BACKEND "wayland,x11"

    // --- cursor ---------------------------------------------------------------
    // alinha o cursor de apps X11/Qt com o `cursor { xcursor-size 20 }` do niri
    // (o gsettings estava em 24, então o cursor mudava de tamanho entre apps)
    XCURSOR_THEME "Adwaita"
    XCURSOR_SIZE "20"

    _JAVA_AWT_WM_NONREPARENTING "1"

    // --- GPU / vídeo ----------------------------------------------------------
{{- if .hardware.hybridNvidia }}
    // Nota: estes três empurram TODO app GL/Vulkan para a RTX 3050, o que contraria
    // o VDPAU/libva (iHD = Intel) logo abaixo e custa bateria em navegação.
    // Se quiser voltar ao padrão (iGPU no desktop, dGPU só em jogo), apague as
    // linhas de prime/vulkan e use `prime-run` ou env por jogo no Steam.
    __NV_PRIME_RENDER_OFFLOAD "1"
    __GLX_VENDOR_LIBRARY_NAME "nvidia"
    __VK_LAYER_NV_optimus "NVIDIA_only"
{{- end }}

    VDPAU_DRIVER "va_gl"
    LIBVA_DRIVER_NAME "iHD"
}
